{
  "name": "obsidian-forester",
  "version": "0.1.0",
  "description": "Forester tree visuals for Obsidian",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "esbuild src/forest.ts --bundle --format=esm --outfile=test/build/forest.mjs --external:obsidian --log-level=warning && node test/numbering.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.6.0"
  }
}
